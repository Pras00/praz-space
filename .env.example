# ==============================================================================
# PRAZ SPACE — ENVIRONMENT VARIABLES CONFIGURATION
# Salin file ini menjadi `.env` lalu sesuaikan nilainya dengan konfigurasi Anda.
# ==============================================================================

# 1. DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Gunakan PostgreSQL lokal atau penyedia cloud seperti Supabase.
# - DATABASE_URL: Menggunakan connection pooler (Transaction mode, port 6543 pada Supabase)
# - DIRECT_URL: Koneksi langsung ke database untuk migrasi Prisma (port 5432 pada Supabase)
#
# Format Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
#
# Format PostgreSQL Lokal:
DATABASE_URL="postgresql://postgres:password@localhost:5432/praz_space?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/praz_space?schema=public"

# 2. AUTHENTICATION & SECURITY (JWT / JOSE)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani token sesi JWT (minimal 32 karakter / 256-bit).
# Anda dapat membuat token acak dengan perintah:
# `openssl rand -hex 32` atau `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
AUTH_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"

# 3. PAYMENT GATEWAY (MIDTRANS)
# ------------------------------------------------------------------------------
# Dapatkan kredensial dari Midtrans Dashboard (https://dashboard.midtrans.com)
# Menu: Settings > Access Keys
#
# Server Key (Rahasia server-side)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"

# Client Key
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# Lingkungan Midtrans:
# - "false" = Sandbox (Mode Simulasi / Uji Coba)
# - "true"  = Production (Mode Live / Transaksi Riil)
MIDTRANS_IS_PRODUCTION="false"

# 4. APLIKASI (BASE URL)
# ------------------------------------------------------------------------------
# URL basis aplikasi (gunakan http://localhost:3000 untuk pengujian lokal)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
